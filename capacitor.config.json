{
  "appId": "com.shouyueliang.nianfoji",
  "appName": "星光播放器",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#0a0705",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashImmersive": true
    }
  }
}
